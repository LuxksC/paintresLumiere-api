# Neon Postgres connection string (get from https://console.neon.tech)
DATABASE_URL=XXXX
# Secret used to sign and verify JWT access tokens (use a long random string in production)
JWT_SECRET=XXXX

# Google Sign-In (mobile) — OAuth 2.0 client IDs from Google Cloud Console (iOS / Android)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# AWS S3 bucket for user uploads (injected automatically by serverless.yml in deployed environments)
# For local development only — set to the actual bucket name
UPLOADS_BUCKET=
