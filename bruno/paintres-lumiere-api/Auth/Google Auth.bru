meta {
  name: Google Auth
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/google
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "idToken": "PASTE_GOOGLE_ID_TOKEN_FROM_MOBILE_SDK"
  }
}

script:post-response {
  const data = res.body;
  if (data && data.accessToken) {
    bru.setEnvVar("accessToken", data.accessToken, { persist: true });
  }
}
